#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUNDLE="$SCRIPT_DIR/packages/coding-agent/dist/bundle/raga.js"

if [[ ! -f "$BUNDLE" ]]; then
	echo "raga: build the bundle first: npm --prefix packages/coding-agent run build" >&2
	exit 1
fi

exec node "$BUNDLE" "$@"
